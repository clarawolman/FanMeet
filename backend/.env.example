# URL del proyecto Supabase (Project Settings -> API)
SUPABASE_URL= 

# service_role key (Project Settings -> API). NUNCA exponer al frontend.
# El backend la usa en los repositories para leer/escribir sin depender de RLS,
# porque la autorizacion real ahora la hacen los services.
SUPABASE_SERVICE_ROLE_KEY=

# anon key (la misma que ya usa el frontend en VITE_SUPABASE_ANON_KEY).
# Se usa solo para las llamadas de auth (signIn/signUp/rpc) que deben
# ejecutarse con el rol anon, igual que hoy hace el cliente.
SUPABASE_ANON_KEY=

# Codigo de acceso a conciertos, se valida 100% server-side. OBLIGATORIA:
# sin default hardcodeado, si falta el backend no arranca (ver config/env.js).
# Es UN SOLO codigo compartido para TODOS los conciertos (no hay codigo por
# concierto individual): unirsePorCodigo() en conciertoService.js compara
# contra este valor sin importar el id_concierto.
CONCIERTO_ACCESS_CODE=FANMEET2026

PORT=4000

# Origen permitido para CORS (la URL donde corre el frontend Vite)
CORS_ORIGIN=http://localhost:5173

# API key GRATIS de Google Gemini para el chatbot Fani
# (https://aistudio.google.com/apikey, no pide tarjeta). NUNCA exponer al
# frontend. Si falta, el backend arranca igual y solo el chatbot responde
# con un error de "no configurado".
GEMINI_API_KEY=

# URL de la app de fans (a donde vuelve el link de "confirma tu mail") y del
# backoffice (link del mail de reportes). En Vercel, poner las URLs reales.
FRONTEND_URL=http://localhost:5173
BACKOFFICE_URL=http://localhost:5175

# Gmail de FanMeet para mandar el mail al moderador cuando hay un reporte.
# GMAIL_CONTRASENA_APP es una "contrasena de aplicacion" de Google (NO la
# contrasena normal): Cuenta de Google -> Seguridad -> Verificacion en 2 pasos
# activada -> Contrasenas de aplicaciones. Si faltan, los mails solo se
# muestran en la consola del backend.
GMAIL_USUARIO=fanmeet100@gmail.com
GMAIL_CONTRASENA_APP=
# A quien le llegan los reportes (por defecto, al mismo GMAIL_USUARIO).
MAIL_MODERADOR=

# Una novedad cargada desde el backoffice solo se notifica a los fans de un
# concierto si tiene al menos esta cantidad de unidos.
MINIMO_UNIDOS_PARA_NOTIFICAR=10
