# URL del proyecto Supabase (Project Settings -> API)
SUPABASE_URL=

# service_role key (Project Settings -> API). NUNCA exponer al frontend.
# El backend la usa en los repositories para leer/escribir sin depender de RLS,
# porque la autorizacion real ahora la hacen los services.
SUPABASE_SERVICE_ROLE_KEY=

# anon key (la misma que ya usa el frontend en VITE_SUPABASE_ANON_KEY).
# Se usa solo para las llamadas de auth (signIn/signUp/rpc) que deben
# ejecutarse con el rol anon, igual que hoy hace el cliente.
SUPABASE_ANON_KEY=

# Codigo de acceso a conciertos. Hoy esta hardcodeado en el frontend
# (src/componentes/home/Home.jsx, CODIGO_PRUEBA). Se mueve aca para que
# la validacion sea server-side.
CONCIERTO_ACCESS_CODE=FANMEET2026

PORT=4000

# Origen permitido para CORS (la URL donde corre el frontend Vite)
CORS_ORIGIN=http://localhost:5173
